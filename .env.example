# Local-only credentials. Never commit a real connection string.
DATABASE_URL=postgresql://tabibi:tabibi_dev_only@localhost:5432/tabibi
LOG_LEVEL=info
# Required by staff operational API; replace through secret management (minimum 32 characters).
STAFF_SESSION_SECRET=development-only-replace-with-32-chars
# Required to authenticate guest bearer envelopes before credential database access (minimum 32 characters).
GUEST_BEARER_SIGNING_SECRET=development-only-guest-signing-replace-with-32-chars
